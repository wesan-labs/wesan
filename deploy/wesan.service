[Unit]
Description=Wesan corporate site (Next.js)
After=network.target

[Service]
Type=simple
User=canakyuz
Group=canakyuz
WorkingDirectory=/var/www/wesan
EnvironmentFile=/var/www/wesan/.env
# bun is user-installed — not in /usr/local/bin on ca-serv
Environment=PATH=/home/canakyuz/.bun/bin:/usr/local/bin:/usr/bin
ExecStart=/home/canakyuz/.bun/bin/bun run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
